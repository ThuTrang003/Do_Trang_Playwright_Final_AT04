      },
      "expected_status": 200
    },
    {
      "case_id": "API_PROFILE_PATCH_02",
      "title": "PATCH /api/profile thiếu field bắt buộc (email) -> 422",
      "use_valid_token": true,
      "payload": {
        "name": "Nguyễn Văn A",
        "email": "",
        "password_old": "",
        "password": "",
        "avatarUrl": "",
