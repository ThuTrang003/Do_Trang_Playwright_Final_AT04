{
  "get_profile_cases": [
    {
      "case_id": "API_PROFILE_GET_01",
      "title": "GET /api/me với token hợp lệ -> 200",
      "use_valid_token": true,
      "expected_status": 200
    },
    {
      "case_id": "API_PROFILE_GET_02",
      "title": "GET /api/me không có token -> 401",
      "use_valid_token": false,
      "expected_status": 401
    }
  ],
  "update_profile_cases": [
    {
      "case_id": "API_PROFILE_PATCH_01",
      "title": "PATCH /api/profile với payload hợp lệ (name/phone/address) -> 200",
      "use_valid_token": true,
      "payload": {
        "name": "API Automation User",
        "phone": "0977123456",
        "address": "Thành phố Hồ Chí Minh"
      },
      "expected_status": 200
    },
    {
      "case_id": "API_PROFILE_PATCH_02",
      "title": "PATCH /api/profile thiếu field bắt buộc (email) -> 422",
      "use_valid_token": true,
      "payload": {
        "email": ""
      },
      "expected_status": 422
    },
    {
      "case_id": "API_PROFILE_PATCH_03",
      "title": "PATCH /api/profile không có token -> 401",
      "use_valid_token": false,
      "payload": {
        "name": "No Token User",
        "email": "auto82@gmail.com",
        "phone": "0977123456",
        "address": "Thành phố Hồ Chí Minh"
      },
      "expected_status": 401
    },
    {
      "case_id": "API_PROFILE_PATCH_04",
      "title": "PATCH /api/profile trùng email -> 400",
      "use_valid_token": true,
      "payload": {
        "name": "Email already exists",
        "email": "hoanp58@gmail.com"
      },
      "expected_status": 400
    }
  ],
  "change_password_cases": [
    {
      "case_id": "API_PWD_01",
      "title": "Đổi mật khẩu qua PATCH /api/profile với password_old/password hợp lệ -> 200",
      "use_valid_token": true,
      "payload": {
        "name": "Trang",
        "email": "auto82@gmail.com",
        "password_old": "Test123@",
        "password": "NewTest123@",
        "phone": "123456789",
        "address": "Thành phố Hà Nội"
      },
      "expected_status": 200
    },
    {
      "case_id": "API_PWD_02",
      "title": "Sai password_old -> 400",
      "use_valid_token": true,
      "payload": {
        "name": "Trang",
        "email": "auto82@gmail.com",
        "password_old": "WrongPassword@1",
        "password": "NewTest123@",
        "phone": "123456789",
        "address": "Thành phố Hà Nội"
      },
      "expected_status": 400
    },
    {
      "case_id": "API_PWD_03",
      "title": "Gọi PATCH /api/profile đổi mật khẩu không có token -> 401",
      "use_valid_token": false,
      "payload": {
        "name": "Trang",
        "email": "auto82@gmail.com",
        "password_old": "Test123@",
        "password": "NewTest123@",
        "phone": "123456789",
        "address": "Thành phố Hà Nội"
      },
      "expected_status": 401
    }
  ]
}
